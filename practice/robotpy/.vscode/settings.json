{
    // Open the practice/robotpy folder in VS Code for these settings.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    // The exercises import wpilibextra from robot/wpilibextra.
    "python.analysis.extraPaths": ["robot"],
    // The flask icon (Testing) runs the exercise checks.
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["checks"]
}
