# Not sure what a .gitignore is?
# See: https://git-scm.com/docs/gitignore

# These are directly copied from Jekyll's first-party docs on `.gitignore` files:
# https://jekyllrb.com/tutorials/using-jekyll-with-bundler/#commit-to-source-control

# Ignore the default location of the built site, and caches and metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

# Browser test tooling (see tools/e2e/README.md)
tools/e2e/node_modules/
tools/e2e/test-results/
tools/e2e/playwright-report/
tools/e2e/blob-report/
tools/e2e/.cache/

# Playwright output if the tests are run from the wrong directory
test-results/
playwright-report/

# Python bytecode from the validators
__pycache__/
